# GitHub App authentication (preferred)
APP_ID=
APP_PRIVATE_KEY=
# APP_LOGIN is derived from REPO_URL automatically for repo-scoped runners

# OR: Personal access token / fine-grained token
# ACCESS_TOKEN=

# Repository to register the runner against
REPO_URL=https://github.com/zwymer/EdTok
RUNNER_NAME_PREFIX=edtok-local
